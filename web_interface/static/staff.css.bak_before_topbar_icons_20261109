
* { box-sizing: border-box; }

[hidden] { display: none !important; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
  background: var(--bg);
  color: var(--text);
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18px;
  min-height: 68px;
  padding: 12px 24px;
  background: var(--text);
  color: #FFFFFF;
  box-shadow: 0 2px 10px rgba(18, 48, 74, 0.12);
}

.brand {
  color: #FFFFFF;
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-decoration: none;
}

.topbar-title {
  padding-left: 18px;
  border-left: 1px solid rgba(255, 255, 255, 0.3);
  font-weight: 600;
}

main {
  width: min(1440px, 100%);
  margin: 0 auto;
  padding: 28px 24px 48px;
}

.panel {
  padding: 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: var(--shadow);
}

#login-panel {
  width: min(460px, 100%);
  margin: 44px auto;
}

h1, h2 {
  color: var(--text);
  line-height: 1.25;
}

h1 {
  margin: 0 0 8px;
  font-size: 1.65rem;
}

h2 {
  margin: 0 0 12px;
  font-size: 1.25rem;
}

p { margin-top: 0; }

.muted { color: var(--muted); }

label {
  display: block;
  margin: 14px 0 6px;
  font-weight: 650;
}

input, select {
  min-height: 46px;
  width: 100%;
  padding: 10px 12px;
  font: inherit;
  color: var(--text);
  background: var(--surface);
  border: 1px solid #A9BBC9;
  border-radius: 10px;
}

input:focus, select:focus, button:focus-visible, a:focus-visible {
  outline: 3px solid #80CBC4;
  outline-offset: 2px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 10px 16px;
  font: inherit;
  font-weight: 650;
  line-height: 1.25;
  color: var(--on-primary);
  background: var(--primary);
  border: 1px solid var(--primary);
  border-radius: 12px;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.btn:hover:not(:disabled) {
  background: var(--primary-dark);
  border-color: var(--primary-dark);
}

.btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn-outline {
  color: var(--text);
  background: #FFFFFF;
  border-color: #B8C8D4;
}

.btn-outline:hover:not(:disabled) {
  color: var(--primary-dark);
  background: var(--soft-teal);
  border-color: var(--primary);
}

#login-form .btn {
  width: 100%;
  margin-top: 10px;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.toolbar h1 { margin-bottom: 6px; }
.toolbar p { margin-bottom: 0; }

.toolbar-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.toolbar-actions select {
  width: auto;
  min-width: 205px;
}

.feedback {
  min-height: 1.5em;
  margin: 12px 0;
  color: var(--muted);
}

.feedback.error {
  color: var(--danger);
  font-weight: 650;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
}

th {
  font-size: 0.82rem;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.035em;
  color: var(--muted);
  background: #F0F5F8;
  white-space: nowrap;
}

tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: #F8FBFC; }

td.status {
  min-width: 110px;
  font-weight: 700;
  white-space: nowrap;
}

td.status[data-status="en attente"] { color: var(--warning); }
td.status[data-status="appelé"] { color: #1D4ED8; }
td.status[data-status="terminé"] { color: #15803D; }

td.actions-cell {
  min-width: 230px;
}

.actions-cell .btn {
  margin: 0 5px 5px 0;
}

.btn-small {
  min-height: 38px;
  padding: 8px 11px;
  font-size: 0.9rem;
}

td.empty {
  padding: 28px;
  text-align: center;
  color: var(--muted);
}

.subpanel {
  margin-top: 24px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #FFFFFF;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}

.detail-line {
  margin: 0;
  padding: 10px 0;
  border-bottom: 1px solid #E7EDF2;
  overflow-wrap: anywhere;
}

.detail-line:last-child { border-bottom: 0; }

.detail-line strong {
  display: inline-block;
  min-width: 210px;
}

.correction-summary {
  padding: 12px;
  border-radius: 10px;
  background: var(--soft-teal);
  font-weight: 650;
  overflow-wrap: anywhere;
}

.correction-actions { margin-top: 16px; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 760px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
    padding: 14px 18px;
  }

  .topbar-title {
    padding-left: 0;
    border-left: 0;
  }

  main { padding: 16px 12px 32px; }

  .panel { padding: 16px; }

  .toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .toolbar-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .toolbar-actions select,
  .toolbar-actions .btn {
    width: 100%;
  }

  th, td { padding: 10px; }

  .detail-line strong {
    display: block;
    min-width: 0;
  }

  .section-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .section-heading .btn { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}

/* Logo HIAR graphique dans les espaces médecin et personnel. */
.brand {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #FFFFFF;
  text-decoration: none;
}

.brand-logo {
  display: block;
  width: 42px;
  height: 42px;
}

/* Boutons icônes de l'espace médecin. */
.doctor-toolbar-actions {
  flex-direction: row;
  align-items: center;
}

.icon-btn {
  width: 46px;
  min-width: 46px;
  height: 46px;
  min-height: 46px;
  padding: 10px;
}

.icon-btn svg {
  display: block;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
}

@media (max-width: 700px) {
  .doctor-toolbar-actions {
    align-items: center;
    flex-direction: row;
    justify-content: flex-end;
  }
}
