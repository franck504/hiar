    min-height: 46px;
  }

  body.hiar-voice-enabled {
    padding-top: 46px;
  }

  body.hiar-voice-enabled main {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  body.hiar-voice-enabled .hiar-footer {
    height: 34px;
    min-height: 34px;
  }

  body.hiar-voice-enabled {
    padding-bottom: 34px;
  }
}

/* HIAR — Consultation centrée et adaptée aux smartphones */
#appointment-screen.screen.active {
  width: 100%;
  max-width: 760px;
  margin-inline: auto;
  box-sizing: border-box;
  text-align: center;
}

#appointment-screen > h2 {
  text-align: center;
  margin: 10px 0 18px;
}

#appointment-screen #consult-progress {
  display: table;
  margin: 0 auto 10px;
}

#appointment-screen .consult-step.active {
  width: 100%;
  max-width: 560px;
  margin-inline: auto;
  text-align: left;
}

#appointment-screen .consult-step.active > .subtitle {
  text-align: center;
  margin: 0 0 16px;
}

#appointment-screen .slot-list {
  width: 100%;
  box-sizing: border-box;
  margin-inline: auto;
}

#appointment-screen .big-button,
#appointment-screen .back-button {
  display: block;
  width: 100%;
  max-width: 420px;
  margin: 12px auto;
  box-sizing: border-box;
}

#appointment-screen .field,
#appointment-screen #consult-date,
#appointment-screen #consult-name,
#appointment-screen #consult-contact,
#appointment-screen #consult-reason {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

@media (max-width: 649px), (orientation: portrait) {
  #appointment-screen.screen.active {
    padding: 16px;
  }

  #appointment-screen .consult-step.active {
    max-width: 100%;
  }

  #appointment-screen .slot-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  #appointment-screen .slot-card {
    min-width: 0;
    overflow-wrap: anywhere;
  }
}
