/* HIAR — couche de redesign visuel additive */
:root {
  --hiar-radius: 20px;
  --hiar-shadow: 0 12px 32px rgba(11, 37, 69, 0.09);
  --hiar-shadow-soft: 0 5px 16px rgba(11, 37, 69, 0.07);
}

body {
  color: var(--marine);
  background:
    radial-gradient(circle at 8% 5%, rgba(32, 201, 232, 0.09), transparent 27rem),
    var(--brume);
}

main {
  width: min(100%, 1100px);
  max-width: 1100px;
  margin-inline: auto;
}

h1, h2, h3 {
  color: var(--marine);
  letter-spacing: -0.025em;
}

.subtitle {
  color: var(--text-2);
  line-height: 1.5;
}

.big-button,
.back-button,
.hiar-voice-button {
  box-sizing: border-box;
  min-height: 56px;
  border-radius: 16px;
  font-family: var(--font-title);
  font-weight: 700;
  transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  -webkit-tap-highlight-color: transparent;
}

.big-button {
  border: 1px solid rgba(26, 115, 200, 0.12);
  background: linear-gradient(135deg, var(--azur), #145A9E);
  box-shadow: var(--hiar-shadow-soft);
}

.big-button:active,
.back-button:active,
.hiar-voice-button:active {
  transform: scale(0.985);
}

.big-button:focus-visible,
.back-button:focus-visible,
.slot-card:focus-visible,
.field:focus-visible,
.hiar-voice-button:focus-visible {
  outline: 3px solid #20C9E8;
  outline-offset: 3px;
}

.big-button.unavailable {
  background: #8797A8;
  box-shadow: none;
}

.back-button {
  border: 1px solid var(--border);
  background: #FFFFFF;
  color: var(--azur);
  box-shadow: none;
}

.screen.active:not(#hiar-splash) {
  padding: clamp(18px, 3vw, 34px);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(213, 225, 238, 0.9);
  border-radius: 26px;
  box-shadow: var(--hiar-shadow);
}

#hiar-splash.screen.active {
  min-height: min(78vh, 620px);
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

#hiar-splash .hiar-robot {
  width: min(300px, 42vw);
}

#home.screen.active {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  align-content: center;
  min-height: 65vh;
}

#home > h1,
#home > .subtitle {
  margin-inline: 0;
  text-align: center;
}

#home > h1 { font-size: clamp(2rem, 4vw, 3rem); }
#home > .subtitle { margin-top: 0; }
#home > .big-button { margin: 0; }

section[id^="menu-"].screen.active {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  align-content: start;
}

section[id^="menu-"] > h2,
section[id^="menu-"] > .back-button {
  grid-column: 1 / -1;
}

section[id^="menu-"] > h2 {
  margin: 0 0 8px;
  text-align: center;
}

section[id^="menu-"] > .big-button,
section[id^="menu-"] > .back-button { margin: 0; }

#appointment-screen.screen.active {
  display: block;
  text-align: left;
}

#appointment-screen > h2 {
  margin: 8px 0 18px;
  text-align: center;
}

#consult-progress {
  display: inline-block;
  margin: 0 auto 8px;
  padding: 7px 13px;
  border-radius: 999px;
  background: var(--azur-soft);
  color: var(--marine);
  font-weight: 700;
}

#appointment-screen .field {
  border: 1.5px solid var(--border);
  border-radius: 13px;
  background: #FFFFFF;
}

#appointment-screen .slot-card,
#appointment-screen .vital-card,
#appointment-screen .recap {
  border-radius: 16px;
  box-shadow: var(--hiar-shadow-soft);
}

#appointment-screen .slot-card.selected {
  border-color: var(--azur);
  box-shadow: 0 0 0 3px rgba(26, 115, 200, 0.12);
}

#appointment-screen .vital-card {
  border-color: var(--border);
  background: #FFFFFF;
}

#appointment-screen .queue-block {
  padding: 18px;
  border-radius: 20px;
  background: var(--azur-soft);
}

#confirm.screen.active {
  display: block;
  text-align: center;
}

#confirm-title { margin-top: 0; }
#confirm-text { line-height: 1.65; }
#confirm .back-button { margin-inline: auto; }

#hiar-voice-bar {
  box-sizing: border-box;
  width: min(calc(100% - 24px), 1100px);
  margin: 14px auto;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: #FFFFFF;
  box-shadow: var(--hiar-shadow-soft);
}

.hiar-voice-button {
  padding: 11px 16px;
  border: 1px solid var(--border);
  background: var(--azur-soft);
  color: var(--marine);
}

@media (orientation: landscape) and (min-width: 650px) {
  body { padding: 14px 22px; }
  main { width: min(100%, 1180px); }

  #home.screen.active {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    min-height: 70vh;
  }

  #home > h1,
  #home > .subtitle { grid-column: 1 / -1; }

  #home > .big-button {
    min-height: 112px;
    padding: 22px;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
  }

  section[id^="menu-"].screen.active {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 18px;
  }

  section[id^="menu-"] > .big-button {
    min-height: 86px;
    padding: 18px;
    font-size: 1.15rem;
  }

  #appointment-screen .slot-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #appointment-screen .consult-step[data-step="3"].active {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 14px;
    align-items: stretch;
  }

  #appointment-screen .consult-step[data-step="3"] > .vital-card {
    min-width: 0;
    margin: 0;
    padding: 12px;
    flex-direction: column;
    align-items: flex-start;
  }

  #appointment-screen .consult-step[data-step="3"] > .vital-card .vital-right {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  #appointment-screen .consult-step[data-step="3"] > .feedback,
  #appointment-screen .consult-step[data-step="3"] > button {
    grid-column: 1 / -1;
    margin: 2px 0;
  }

  #appointment-screen .consult-step[data-step="3"] > button {
    min-height: 48px;
  }

  #appointment-screen .consult-step[data-step="2"],
  #appointment-screen .consult-step[data-step="4"],
  #appointment-screen .consult-step[data-step="5"] {
    max-width: 900px;
    margin-inline: auto;
  }
}

@media (max-width: 649px), (orientation: portrait) {
  body { padding: 12px; }

  .screen.active:not(#hiar-splash) {
    padding: 18px;
    border-radius: 20px;
  }

  #home.screen.active { min-height: 0; }
  #home > .big-button { min-height: 64px; }
  section[id^="menu-"] > .big-button { min-height: 60px; }

  #appointment-screen .vital-card {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  #appointment-screen .vital-right {
    flex-wrap: wrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .big-button,
  .back-button,
  .hiar-voice-button { transition: none; }
}

/* ==========================================================
   HIAR — identité visuelle, icônes et commandes compactes
   Couche additive : aucune logique fonctionnelle modifiée.
   ========================================================== */

.hiar-icon-library {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Identité HIAR et logo */
.hiar-brand-lockup {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.hiar-logo-mark {
  display: block;
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  color: var(--azur);
}

.hiar-brand-name {
  color: var(--marine);
  font-family: var(--font-title);
  font-size: clamp(1.5rem, 3vw, 2.1rem);
  font-weight: 800;
  letter-spacing: .09em;
}

.hiar-splash-lockup {
  margin-top: 2px;
}

.hiar-splash-lockup .hiar-logo-mark {
  width: 38px;
  height: 38px;
}

.hiar-tagline {
  max-width: 540px;
  margin: 0 auto;
  color: var(--text-2);
  font-size: clamp(.82rem, 1.8vw, 1rem);
  line-height: 1.5;
  text-align: center;
}

#hiar-splash h1 {
  margin: 8px 0 0;
  font-family: var(--font-title);
  font-weight: 800;
}

/* En-tête de l'accueil principal */
.hiar-home-heading {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  text-align: center;
  margin-bottom: 8px;
}

.hiar-home-heading .hiar-logo-mark {
  width: 42px;
  height: 42px;
}

.hiar-home-heading h1 {
  margin: 3px 0 0;
  font-family: var(--font-title);
  font-size: clamp(1.65rem, 3.5vw, 2.35rem);
}

.hiar-home-heading .subtitle {
  margin: 0;
  font-size: clamp(.92rem, 1.8vw, 1.08rem);
}

.hiar-home-caption {
  margin: 0;
  color: var(--text-2);
  font-size: .76rem;
  letter-spacing: .035em;
}

/* Panneaux des trois services */
.service-tile.big-button {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 15px;
  min-width: 0;
  min-height: 104px;
  margin: 0;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 19px;
  background: linear-gradient(145deg, #FFFFFF, #F7FAFE);
  color: var(--marine);
  text-align: left;
  box-shadow: var(--hiar-shadow-soft);
  animation: hiar-fade-up 380ms ease both;
}

.service-tile:nth-of-type(2) { animation-delay: 45ms; }
.service-tile:nth-of-type(3) { animation-delay: 90ms; }
.service-tile:nth-of-type(4) { animation-delay: 135ms; }

.service-tile-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  border-radius: 16px;
  background: var(--azur-soft);
  color: var(--azur);
}

.service-tile-icon svg {
  width: 29px;
  height: 29px;
}

.service-tile-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}

.service-tile-copy strong {
  color: var(--marine);
  font-family: var(--font-title);
  font-size: 1.03rem;
  font-weight: 750;
}

.service-tile-copy small {
  color: var(--text-2);
  font-size: .76rem;
  font-weight: 450;
  line-height: 1.4;
}

.service-tile-arrow {
  width: 19px;
  height: 19px;
  flex: 0 0 auto;
  color: #7890A9;
}

/* Icônes et choix dans les sous-menus */
.menu-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.menu-heading-icon {
  width: 29px;
  height: 29px;
  color: var(--azur);
}

.menu-item.big-button {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 76px;
  min-width: 0;
  margin: 0;
  padding: 14px 17px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: #FFFFFF;
  color: var(--marine);
  text-align: left;
  box-shadow: var(--hiar-shadow-soft);
}

.menu-item-icon {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  border-radius: 13px;
  background: var(--azur-soft);
  color: var(--azur);
}

.menu-item-icon svg {
  width: 25px;
  height: 25px;
}

.menu-item-label {
  flex: 1;
  min-width: 0;
  font-family: var(--font-title);
  font-size: .96rem;
  font-weight: 700;
}

.menu-item-arrow {
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
  color: #8A9CB0;
}

.menu-item.unavailable {
  background: #F1F4F7;
  color: #718096;
  box-shadow: none;
}

.menu-item.unavailable .menu-item-icon {
  background: #E4EAF0;
  color: #8192A4;
}

/* Retour sous forme d'icône, en haut à gauche */
.screen.active:not(#hiar-splash) > .icon-back,
#appointment-screen.screen.active .consult-step.active > .icon-back {
  position: fixed;
  z-index: 1002;
  top: 12px;
  left: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  min-height: 42px;
  margin: 0;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: #FFFFFF;
  color: var(--marine);
  box-shadow: 0 4px 14px rgba(11, 37, 69, .10);
}

.icon-back svg {
  width: 21px;
  height: 21px;
}

/* Les commandes vocales viennent à côté de Retour */
#hiar-voice-bar {
  position: fixed;
  z-index: 1001;
  top: 12px;
  right: auto;
  bottom: auto;
  left: 64px;
  display: flex;
  width: fit-content;
  max-width: calc(100vw - 76px);
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 4px;
  padding: 6px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 4px 16px rgba(11, 37, 69, .10);
}

#hiar-voice-bar[hidden] {
  display: none !important;
}

.hiar-voice-controls {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 5px;
}

#hiar-voice-bar .hiar-voice-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 6px 9px;
  border: 1px solid #DCE6F0;
  border-radius: 10px;
  background: #F7FAFE;
  color: var(--marine);
  font-family: var(--font-body);
  font-size: .72rem;
  font-weight: 700;
  white-space: nowrap;
}

#hiar-voice-bar .hiar-voice-button:active {
  transform: scale(.97);
}

#hiar-voice-status {
  width: auto;
  max-width: 230px;
  margin: 0;
  color: var(--text-2);
  font-size: .67rem;
  line-height: 1.3;
  text-align: left;
}

#hiar-voice-bar small {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Réservation de place pour la barre de commandes */
body.hiar-voice-enabled {
  padding-bottom: 12px;
}

body.hiar-voice-enabled main {
  padding-top: 56px;
}

/* Petits détails sur les formulaires et les boutons */
#appointment-screen .field {
  min-height: 46px;
  padding: 11px 13px;
  border-radius: 13px;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

#appointment-screen .field:focus {
  border-color: var(--azur);
  box-shadow: 0 0 0 3px rgba(26, 115, 200, .11);
  outline: none;
}

#appointment-screen .big-button,
#appointment-screen .back-button {
  min-height: 46px;
  border-radius: 13px;
  font-size: .92rem;
}

#appointment-screen .slot-card {
  transition: border-color 160ms ease, box-shadow 160ms ease,
              transform 160ms ease;
}

#appointment-screen .feedback {
  line-height: 1.45;
}

/* Interactions discrètes */
@keyframes hiar-fade-up {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.service-tile,
.menu-item,
.icon-back {
  transition: transform 160ms ease, box-shadow 160ms ease,
              border-color 160ms ease, background-color 160ms ease;
  -webkit-tap-highlight-color: transparent;
}

@media (hover: hover) {
  .service-tile:hover,
  .menu-item:hover {
    transform: translateY(-2px);
    border-color: #B7D1E8;
    box-shadow: 0 10px 22px rgba(11, 37, 69, .10);
  }
}

@media (orientation: landscape) and (min-width: 650px) {
  .service-tile.big-button {
    min-height: 112px;
    padding: 18px 20px;
  }

  .menu-item.big-button {
    min-height: 82px;
  }

  .hiar-home-heading {
    margin-bottom: 12px;
  }
}

@media (max-width: 649px), (orientation: portrait) {
  .service-tile.big-button {
    min-height: 82px;
    padding: 13px;
    gap: 11px;
  }

  .service-tile-icon {
    width: 44px;
    height: 44px;
    flex-basis: 44px;
    border-radius: 13px;
  }

  .service-tile-icon svg {
    width: 25px;
    height: 25px;
  }

  .service-tile-copy strong {
    font-size: .94rem;
  }

  .service-tile-copy small {
    font-size: .70rem;
  }

  .menu-item.big-button {
    min-height: 66px;
    padding: 11px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .service-tile,
  .menu-item,
  .icon-back {
    animation: none !important;
    transition: none !important;
  }
}


/* HIAR — fiches de renseignements et responsive final */

#confirm.is-information #confirm-title {
  max-width: 900px;
  margin: 4px auto 18px;
  font-family: var(--font-title);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  text-align: center;
}

#confirm.is-information #confirm-text {
  box-sizing: border-box;
  width: min(100%, 920px);
  max-height: min(56vh, 560px);
  margin: 0 auto 18px;
  padding: clamp(17px, 2.5vw, 28px);
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: #30465E;
  background: #F8FAFD;
  border: 1px solid var(--border);
  border-left: 4px solid var(--azur);
  border-radius: 16px;
  box-shadow: var(--hiar-shadow-soft);
  font-size: clamp(.91rem, 1.35vw, 1.04rem);
  line-height: 1.8;
  text-align: left;
}

#confirm.is-information #confirm-debug {
  max-width: 920px;
  margin-inline: auto;
  overflow-wrap: anywhere;
}

/* Commandes vocales compactes */
#hiar-voice-bar .hiar-voice-button {
  box-sizing: border-box;
  width: 36px;
  min-width: 36px;
  height: 36px;
  min-height: 36px;
  padding: 8px;
}

#hiar-voice-bar .hiar-voice-button svg {
  display: block;
  width: 18px;
  height: 18px;
}

#hiar-voice-bar .hiar-voice-button.is-listening {
  border-color: #20AFCB;
  background: #E5F8FC;
  color: #087D99;
  box-shadow: 0 0 0 3px rgba(32, 201, 232, .13);
}

.hiar-voice-hints {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 5px;
  color: #7A90A7;
}

.hiar-voice-hints svg {
  width: 16px;
  height: 16px;
}

#hiar-voice-status:empty {
  display: none;
}

/* Protection contre les débordements */
#home,
section[id^="menu-"],
#appointment-screen,
#confirm {
  min-width: 0;
  max-width: 100%;
}

.service-tile,
.menu-item,
#appointment-screen .vital-card,
#appointment-screen .recap {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* Portrait et petits écrans */
@media (max-width: 649px), (orientation: portrait) {
  #confirm.is-information #confirm-text {
    width: 100%;
    max-height: min(52vh, 470px);
    padding: 16px;
    font-size: .91rem;
    line-height: 1.7;
  }

  #hiar-voice-bar {
    left: 60px;
    max-width: calc(100vw - 70px);
  }

  #hiar-voice-bar .hiar-voice-button {
    width: 34px;
    min-width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 7px;
  }

  .hiar-voice-hints {
    gap: 3px;
    padding-inline: 2px;
  }

  .hiar-voice-hints svg {
    width: 14px;
    height: 14px;
  }

  body.hiar-voice-enabled main {
    padding-top: 52px;
  }

  #appointment-screen .slot-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Smartphones en paysage */
@media (orientation: landscape) and (min-width: 650px) and (max-height: 500px) {
  #confirm.is-information #confirm-text {
    max-height: 43vh;
    padding: 13px 17px;
    line-height: 1.55;
  }

  body.hiar-voice-enabled main {
    padding-top: 50px;
  }

  #hiar-voice-bar {
    top: 7px;
    left: 58px;
    padding: 4px;
  }

  .screen.active:not(#hiar-splash) {
    padding-top: 16px;
    padding-bottom: 16px;
  }
}

/* Très petits téléphones */
@media (max-width: 360px) {
  #hiar-voice-bar {
    left: 56px;
    max-width: calc(100vw - 64px);
  }

