/* HIAR — grille des créneaux et couleurs des actions */
:root {
  --hiar-blue: #1A73C8;
  --hiar-blue-soft: #EAF3FC;
  --hiar-green: #15803D;
  --hiar-green-soft: #DCFCE7;
  --hiar-red: #B91C1C;
  --hiar-red-soft: #FEE2E2;
  --hiar-yellow: #A16207;
  --hiar-yellow-soft: #FEF3C7;
}

/* Deux créneaux par ligne : deux en haut, deux en dessous. */
#appointment-screen .slot-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  align-items: stretch;
}

#appointment-screen .slot-card {
  box-sizing: border-box;
  min-width: 0;
  min-height: 100px;
  margin: 0;
  padding: 13px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1.5px solid #D5E1EE;
  border-radius: 15px;
  background: #FFFFFF;
  color: var(--marine);
  text-align: center;
  box-shadow: 0 3px 10px rgba(11, 37, 69, .045);
  transition: background-color 150ms ease, border-color 150ms ease,
              box-shadow 150ms ease, transform 150ms ease;
}

#appointment-screen .slot-time {
  color: var(--marine);
  font-family: var(--font-title);
  font-size: 1.08rem;
  font-weight: 800;
}

#appointment-screen .slot-doctor {
  max-width: 100%;
  color: var(--text-2);
  font-size: .78rem;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

#appointment-screen .slot-state {
  color: var(--hiar-green);
  font-size: .72rem;
  font-weight: 700;
}

/* Élément sélectionné : vert, contour et halo visibles. */
#appointment-screen .slot-card.selected,
#appointment-screen .slot-card[aria-pressed="true"] {
  border: 2px solid var(--hiar-green);
  background: var(--hiar-green-soft);
  color: #14532D;
  box-shadow: 0 0 0 3px rgba(21, 128, 61, .12);
  transform: translateY(-1px);
}

#appointment-screen .slot-card.selected .slot-time {
  color: #14532D;
}

#appointment-screen .slot-card:disabled {
  border-color: #E1E6EC;
  background: #F0F3F6;
  color: #8492A2;
  box-shadow: none;
  opacity: .85;
  cursor: not-allowed;
}

#appointment-screen .slot-card:disabled .slot-state {
  color: #7C8794;
}

#appointment-screen .slot-card:focus-visible {
  outline: 3px solid #20C9E8;
  outline-offset: 3px;
}

/* Bleu : continuer et naviguer. */
#appointment-screen #step1-next,
#appointment-screen #step2-next,
#appointment-screen #step3-next {
  border: 1px solid var(--hiar-blue);
  background: var(--hiar-blue);
  color: #FFFFFF;
}

#appointment-screen #step1-next:disabled {
  border-color: #CFD8E2;
  background: #E5EAF0;
  color: #7D8997;
  box-shadow: none;
  cursor: not-allowed;
}

/* Vert : confirmation explicite. */
#appointment-screen #step4-confirm {
  border: 1px solid var(--hiar-green);
  background: var(--hiar-green);
  color: #FFFFFF;
}

/* Bleu clair : modifier ou revenir. */
#appointment-screen #step4-back {
  border: 1px solid #B7D3EE;
  background: var(--hiar-blue-soft);
  color: #145A9E;
}

/* Rouge : annulation, et non simple retour. */
#appointment-screen .consult-step[data-step="4"] > button[data-goto="home"],
#confirm > button[data-goto="home"] {
  border: 1px solid #F0B7B7;
  background: var(--hiar-red-soft);
  color: var(--hiar-red);
}

/* Jaune : attente et avertissement. */
#appointment-screen .pill-wait {
  border-color: #F4D58A;
  background: var(--hiar-yellow-soft);
  color: #854D0E;
}

/* Les actions actives restent lisibles au toucher. */
#appointment-screen button:not(:disabled):active {
  transform: scale(.985);
}

@media (max-width: 360px) {
  #appointment-screen .slot-list {
    gap: 8px;
  }

  #appointment-screen .slot-card {
    min-height: 88px;
    padding: 10px 6px;
  }

  #appointment-screen .slot-time {
    font-size: .98rem;
  }

  #appointment-screen .slot-doctor {
    font-size: .70rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  #appointment-screen .slot-card {
    transition: none;
  }
}


