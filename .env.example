# Exemple de configuration locale HIAR (copier vers .env — NE JAMAIS COMMITER .env)

# Code PIN d'accès à l'interface Web Médecin & Administration (6 chiffres)
HIAR_WEB_PIN=123456

# Jeton d'authentification du personnel médical (portail Web Médecin)
HIAR_STAFF_API_TOKEN=changez_moi

# ==============================================================================
# LLM Primaire : Groq API (très rapide, gratuit avec compte Groq)
# Inscrivez-vous sur https://console.groq.com/ pour obtenir une clé.
# Ajoutez autant de clés que souhaité (GROQ_API_KEY_1 .. _20) pour le
# round-robin automatique en cas de quota 429.
# ==============================================================================
GROQ_API_KEY_1=votre_cle_groq_1
# GROQ_API_KEY_2=votre_cle_groq_2

# Modèle Groq (par défaut : qwen/qwen3.8-27b, rapide et précis)
HIAR_GROQ_MODEL=qwen/qwen3.8-27b

# Timeout réseau Groq en secondes (bascule immédiate sur Qwen local au-delà)
HIAR_GROQ_TIMEOUT=8.0

# Durée de pause (cooldown) d'une clé après une erreur HTTP 429 (en secondes)
HIAR_GROQ_COOLDOWN=60

# Backend LLM : hybrid_groq_qwen (recommandé) | groq | ollama
HIAR_LLM_BACKEND=hybrid_groq_qwen
