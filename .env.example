# Exemple de configuration locale HIAR (copier vers .env — NE JAMAIS COMMITER .env)

# Jeton d'authentification du personnel médical (portail Web Médecin)
HIAR_STAFF_API_TOKEN=changez_moi

# ==============================================================================
# LLM Primaire : Gemini API (prototypage avec rotation round-robin des clés)
# Ajoutez autant de clés gratuites que souhaité (GEMINI_API_KEY_1 .. _20).
# Lorsque vous passerez en abonnement pro, une seule clé GEMINI_API_KEY_1 suffit.
# ==============================================================================
GEMINI_API_KEY_1=votre_cle_gemini_1
GEMINI_API_KEY_2=votre_cle_gemini_2
# GEMINI_API_KEY_3=votre_cle_gemini_3

# Modèle Gemini (par défaut : gemini-2.5-flash-lite, quota gratuit le plus généreux)
HIAR_GEMINI_MODEL=gemini-2.5-flash-lite

# Timeout réseau Gemini en secondes (bascule immédiate sur Qwen local au-delà)
HIAR_GEMINI_TIMEOUT=4.0

# Durée de pause (cooldown) d'une clé après une erreur HTTP 429 (en secondes)
HIAR_GEMINI_COOLDOWN=60

# Backend LLM : hybrid_gemini_qwen (recommandé) | gemini | ollama
HIAR_LLM_BACKEND=hybrid_gemini_qwen
